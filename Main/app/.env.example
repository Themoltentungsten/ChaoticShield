# ─────────────────────────────────────────────────────────────────────────────
# ChaoticShield — Environment Configuration
# Copy this to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# AI detection provider: "local" (default, in-browser Tesseract.js) or "cloud"
AI_PROVIDER=local

# Cloud AI API key (only used when AI_PROVIDER=cloud)
AI_API_KEY=

# Enable cloud AI processing (requires explicit user opt-in)
ENABLE_CLOUD_AI=false

# OCR engine for local detection: "tesseract" (default)
OCR_ENGINE=tesseract

# ── Selective-scan AI detection (server-side, /api/selective/detect) ────────
# Any OpenAI-compatible vision endpoint (preferred — used when all three set):
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Or Google Gemini directly (used only when AI_API_KEY/AI_BASE_URL are unset):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Server configuration
PORT=7100
HOST=0.0.0.0
